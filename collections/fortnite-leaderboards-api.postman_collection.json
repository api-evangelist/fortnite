          "id": "65eb0598-9568-4bab-b637-b25f5e97e796",
          "name": "Fortnite Tracker List Leaderboard",
          "request": {
            "name": "Fortnite Tracker List Leaderboard",
            "description": {
              "content": "Retrieve a paginated leaderboard for a given mode, platform, and time window. Used to surface top players by score, wins, kills, or matches played across the global Tracker Network cohort.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "leaderboards",
                ":mode",
                ":platform",
                ":window"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "page",
                  "value": "0",
                  "description": "Page index for paginated results (zero-based)."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "mode",
                  "description": "(Required) Game mode. One of `p2` (solo), `p10` (duo), `p9` (squad)."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "platform",
                  "description": "(Required) Player platform (`pc`, `xbl`, `psn`)."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "window",
                  "description": "(Required) Statistic and time window. Common values include `current_wins`, `current_kills`, `current_matches`, `lifetime_wins`, `lifetime_kills`, `lifetime_score`."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
